 "bloklar": [
  {
   "metin": "Dünyaya Geliş. Delhi'nin kuzeyindeki Müminpûr (Müminâbâd) kasabasında, Lâçin Türkü Seyfeddin Mahmûd 'un oğlu olarak dünyaya geldi.",
   "bas": 0,
   "sure": 11.304
  },
  {
   "metin": "Babasını Kaybetti. Yedi-sekiz yaşlarında yetim kaldı; dedesi emîr İmâdülmülk 'ün himayesine girdi ve onun edebî-ilmî sohbetleriyle yetişti.",
   "bas": 11.304,
   "sure": 10.992
  },
  {
   "metin": "Şairlik ve Nizâmeddin Evliyâ ile Tanışma. On iki yaşında şair olarak belli bir seviyeye ulaştı; Çiştiyye şeyhi ile tanıştı, mûsikiye ilgisi bu dönemde başladı.",
   "bas": 22.296,
   "sure": 12.408
  },
  {
   "metin": "İlk Divan: Tuhfetü's-sıgâr. On dokuz yaşında ilk divanını tertip etti; eser y. 1272 (670) yılında tamamlandı.",
   "bas": 34.704,
   "sure": 10.896
  },
  {
   "metin": "Dedesinin Vefatı. İmâdülmülk 'ün ölümü üzerine Türk emîri Keşli Han 'ın maiyetine girdi; onun meclislerinde söz sahibi oldu.",
   "bas": 45.6,
   "sure": 10.344
  },
  {
   "metin": "Bengal Seferi ve İlk Fetihnâme. Buğra Han 'ın hizmetine girdi; Bengal seferine katıldı ve ilk mensur eseri olan Leknevtî fetihnâmesi ni sundu.",
   "bas": 55.944,
   "sure": 11.664
  },
  {
   "metin": "Delhi'ye Dönüş. Buğra Han Bengal valiliğine atanınca beraber gitti, ancak yakınlarının hasretine dayanamayıp Delhi'ye döndü.",
   "bas": 67.608,
   "sure": 9.792
  },
  {
   "metin": "Mültan: Kaan Mâlik'in Nedimi. Mültanlı Prens Muhammed Kaan Mâlik 'in davetiyle nedimleri arasına katıldı; burada Hasan Dihlevî ile tanıştı.",
   "bas": 77.4,
   "sure": 11.256
  },
  {
   "metin": "Moğol Esareti. Moğollar Mültan'a girip Kaan Mâlik 'i öldürdü; Hüsrev, Hasan Dihlevî ile birlikte esir düştü.",
   "bas": 88.656,
   "sure": 9.192
  },
  {
   "metin": "Vasatü'l-hayât Divanının Tertibi. 20–33 yaş arasındaki şiirlerini \"orta hayat\" divanında derledi (8441 beyit); Nizâmeddin Evliyâ 'nın himmetiyle dilinin açıldığını söyler.",
   "bas": 97.848,
   "sure": 14.304
  },
  {
   "metin": "Balaban Han'ın Ölümü. Esaretten kurtulduktan sonra Balaban 'ın ölümüne dek dost ve akrabalarıyla Müminâbâd'da oturdu; saray davetini kabul etmedi.",
   "bas": 112.152,
   "sure": 11.64
  },
  {
   "metin": "Oudh'a Gidiş. Himayesine girdiği Hâtem Han Oudh'a vali olunca bir defa daha Delhi'den ayrıldı; kısa süre sonra geri döndü.",
   "bas": 123.792,
   "sure": 9.648
  },
  {
   "metin": "Saray Şairi Unvanı. Delhi'ye döndü ve saraydan gelen teklifi kabul etti; kendisine \"saray şairi\" unvanı verildi.",
   "bas": 133.44,
   "sure": 9.864
  },
  {
   "metin": "Fîrûz Şah Halacî Devri. Sarayda mushafdarlık görevinde bulundu. Miftâhu'l-fütûh (1291/690) bu dönemin zaferlerini anlatır.",
   "bas": 143.304,
   "sure": 12.72
  },
  {
   "metin": "Alâeddin Halacî: En Verimli Yıllar. Savaşı seven sultandan beklediği ilgiyi göremediyse de geniş zaman bulup eser yazma imkânına kavuştu.",
   "bas": 156.024,
   "sure": 11.016
  },
  {
   "metin": "Nizâmeddin Evliyâ'ya İntisap. Çocukluğundan beri görüştüğü şeyhe bu yıl tam intisap etti; tarikat yolculuğu ağırlık kazandı.",
   "bas": 167.04,
   "sure": 9.984
  },
  {
   "metin": "Kutbüddin Mübârek Şâh Devri. Şiir ve müziğe ilgisi Hüsrev'e eski itibarını kazandırdı; Nüh Sipihr dönemi betimler.",
   "bas": 177.024,
   "sure": 9.48
  },
  {
   "metin": "Son Bengal Seferi. Sultan Gıyâseddin Tuğluk zamanında Bengal seferine katıldı.",
   "bas": 186.504,
   "sure": 7.488
  },
  {
   "metin": "Şeyhinin Vefatı ve İnziva. Şeyhi Nizâmeddin Evliyâ 'nın öldüğünü haber alınca Delhi'ye döndü; Gıyâspûr'daki mezarında bir müddet inzivaya çekildi.",
   "bas": 193.992,
   "sure": 11.064
  },
  {
   "metin": "Vefat. İnzivanın hemen ardından vefat etti ve Nizâmeddin Evliyâ 'nın kabri yakınına defnedildi; türbeleri Delhi'nin önemli ziyaret yerlerindendir.",
   "bas": 205.056,
   "sure": 11.304
  }
 ],
