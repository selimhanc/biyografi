 "bloklar": [
  {
   "metin": "Cey Kasabasında Doğum. Aslen İranlı olup İsfehân yakınındaki Cey kasabasında doğdu. Müslüman olmadan önceki ismi Mâbeh idi.",
   "bas": 0,
   "sure": 11.304
  },
  {
   "metin": "Mecûsî iken Hıristiyan Olması. Gençliğinde Mecûsî iken, arayış içinde Hıristiyan râhipleri ile tanışıp Hıristiyanlığa geçti. Nihâyet Medîne'ye gelerek Müslüman oldu.",
   "bas": 11.304,
   "sure": 14.256
  },
  {
   "metin": "Medîne'de Müslüman Olması. Nihâyet Medîne'ye gelip Müslüman oldu ve Ehl-i Beyt'ten sayıldı. Peygamberimiz (s.a.v.) ona \"Selmân\" ismini verdi ve Ebû'd-Derdâ (r.a.) ile kardeş yaptı.",
   "bas": 25.56,
   "sure": 15.336
  },
  {
   "metin": "\"Selmân İbnü'l-İslâm\" Söylenmesi. Bulunduğu mecliste herkes nesebini söyledi; sıra ona gelince \"Selmân İbnü'l-İslâm\" diye cevap verdi ve ondan sonra bu isimle anıldı. Resûlüllâh (s.a.v.) ona \"Selmânü'l-Hayr\" lâkâbını bahşetti.",
   "bas": 40.896,
   "sure": 19.176
  },
  {
   "metin": "En Yüksek Kemâle Kavuşması. Ashâb-ı Kirâm arasında en hayırlı, en zâhid ve en faziletli olanlardandı. Peygamber Efendimiz'in (s.a.v.) sohbetleri şerefiyle en yüksek kemal mertebesine kavuşmuştur.",
   "bas": 60.072,
   "sure": 16.464
  },
  {
   "metin": "Geceleri Peygamber Sohbetinde. Hz. Âişe (r.anhâ) \"Selmân (r.a.) geceleri Resûlüllâh'ın (s.a.v.) sohbetinde bulunurdu; geceleri biz hanımlarından daha fazla Resûlüllâh'ın (s.a.v.) sohbetinde bulunurdu\" demiştir. Künyesi Ebû Abdullah'tır.",
   "bas": 76.536,
   "sure": 19.008
  },
  {
   "metin": "Hz. Ebû Bekir'e Husûsî Nisbeti. Silsile-i Sâdât'ın ikinci halkası olarak Hz. Ebû Bekir es-Sıddîk'e (r.a.) husûsî bir nisbeti vardır. Peygamber Efendimiz'in (s.a.v.) saçlarını tıraş ettiği için berberlerin pîri sayılırdı.",
   "bas": 95.544,
   "sure": 18.216
  },
  {
   "metin": "Medâin'de Vefat. Uzun ömür yaşayanlardandı. Hz. Osman'ın (r.a.) halifeliği devrinde hastalanarak Hicretin 33. (M. 654) senesinde iki yüz elli yaşında Medâin'de âhirete irtihâl etti.",
   "bas": 113.76,
   "sure": 16.152
  },
  {
   "metin": "Türbenin Yeniden Yaptırılması. Osmanlılar devrinde büyük ehemmiyet verilen türbesi Dördüncü Murad Han tarafından yeniden yaptırıldı. Bu türbenin etrafında zamanla oluşan kasabaya Selmân-ı Pâk denmeye başlandı. Kabrinin yanında Huzeyfetü'bnu'l-Yemân'ın (r.a.) kabri vardır.",
   "bas": 129.912,
   "sure": 21.048
  }
 ],
