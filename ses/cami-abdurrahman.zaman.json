 "toplamSure": 146.472,
 "bloklar": [
  {
   "metin": "Harcird'de Doğum. Horasan'ın Câm şehrinin Harcird kasabasında doğdu. Câm mahlasını doğduğu şehir ve Ahmed-i Nâmekî'ye saygısından aldığını anlatır.",
   "bas": 0,
   "sure": 12.528
  },
  {
   "metin": "Herat'ta Tahsil. Babası Herat'a gidip Nizâmiye Medresesi'ne müderris olunca Câmî öğrenimini orada sürdürdü. Arap dili ve edebiyatının temel metinlerini Cüneyd-i Usûlî'den okudu.",
   "bas": 12.528,
   "sure": 13.92
  },
  {
   "metin": "Semerkant'ta Dokuz Yıl. Uluğ Bey zamanında büyük bir ilim merkezi olan Semerkant'a giderek dokuz yıl kaldı. Kadızâde-i Rûmî'den riyâziyyât, Fethullah-ı Tebrîzî'den çeşitli ilimler öğrendi.",
   "bas": 26.448,
   "sure": 14.784
  },
  {
   "metin": "Ali Kuşçu ile Görüşme. Astronomi ve matematik âlimi Ali Kuşçu Herat'a geldiğinde Câmî'ye zor astronomi soruları sordu; cevapları aldıktan sonra riyâzî meseleler üzerinde birlikte çalıştı ve onu takdir etti.",
   "bas": 41.232,
   "sure": 14.88
  },
  {
   "metin": "Sa‘deddîn-i Kâşgarî'ye İntisap. Genç yaşta bütün ilimlere vâkıf olmasına rağmen Semerkant dönüşünde Nakşibendî şeyhlerinden Sa'deddin-i Kâşgarî'ye intisap etti. Medresede ders vermeyi, bir tekkeye şeyhlik yapmaya tercih etti.",
   "bas": 56.112,
   "sure": 16.896
  },
  {
   "metin": "Ubeydullah Ahrâr ile Bağlantı. Sa'deddin'in vefatından sonra halefi Hâce Ubeydullah Ahrâr'a bağlandı. Birkaç defa görüştü ve mektuplaşarak ilişkiyi sürdürdü; Ahrâr'ın Câmî üzerindeki etkisi büyüktü.",
   "bas": 73.008,
   "sure": 16.2
  },
  {
   "metin": "Hac ve Bağdat. Herat'tan ayrılıp hac için yola çıktı. Bağdat'ta Silsiletü'z-Zeheb'in Ehl-i beyt bölümüne yapılan itiraza karşı İslâmî bir savunma yaptı ve oradaki âlimlerin takdirini kazandı.",
   "bas": 89.208,
   "sure": 14.688
  },
  {
   "metin": "Tebriz ve Herat'a Dönüş. Hac dönüşünde Tebriz'e gitti. Uzun Hasan'ın kalmasını istemesine rağmen ayrıldı ve 18 Şâban 878 (8 Ocak 1474) tarihinde Herat'a döndü.",
   "bas": 103.896,
   "sure": 15.888
  },
  {
   "metin": "Herat Medresesi ve Edebiyat. Hüseyin Baykara'nın yaptırdığı medresede Arap dili, edebiyatı, hadis ve tefsir dersleri okuttu. Eserlerinin çoğunu bu dönemde yazdı.",
   "bas": 119.784,
   "sure": 13.608
  },
  {
   "metin": "Herat'ta Vefat. Cuma günü Herat'ta vefat etti. Cenazesi devrin ileri gelenleri tarafından kaldırıldı ve şeyhi Sa'deddin-i Kâşgarî'nin kabrinin yanına defnedildi.",
   "bas": 133.392,
   "sure": 13.08
  }
 ],
