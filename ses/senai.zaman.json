 "bloklar": [
  {
   "metin": "Gazne'de Doğum. Gazne'de dünyaya geldi. 524 (1130) yılında Ḥadîḳa'sını yazmaya başladığında altmış yaşında olduğunu söylediğinden 464 (1071–72) doğum tarihi çıkarılır.",
   "bas": 0,
   "sure": 16.44
  },
  {
   "metin": "Farsça ve Arapça Eğitimi. İyi bir eğitim gördü. Gençliğinde Farsça yazan şairlerin divanlarının yanında Arapça şairleri de okudu; şiirlerinde soylu bir aileden geldiğini söyler.",
   "bas": 16.44,
   "sure": 14.448
  },
  {
   "metin": "Gazne Sarayında Methiyeler. Sultan İbrâhim, III. Mesud ve Behram Şah'ı metheden şiirler yazdı. Methiyelerinin çoğu gençlik dönemine aittir.",
   "bas": 30.888,
   "sure": 13.416
  },
  {
   "metin": "Gazne'den Belh'e. III. Mesud hükümdâr olurken Gazne'den ayrıldı. Belh'te geçimini sağlayıp güvene kavuştu; tevhid, zühd ve uzlet temalı şiirleri burada yazdı.",
   "bas": 44.304,
   "sure": 13.176
  },
  {
   "metin": "Kârnâme-i Belḫ. 497 beyitlik bu mesnevi, devrin ileri gelenlerini hicveden mütâyebenâme olarak da bilinir. Senâî'nin hayatı hakkında önemli bilgiler verir.",
   "bas": 57.48,
   "sure": 13.92
  },
  {
   "metin": "Horasan Şehirlerinde Geziler. Belh'te bulunduğu sırada Serahs, Herat ve Nîşâbur'u ziyaret etti; bu şehirlerde mutasavvıflarla tanıştı.",
   "bas": 71.4,
   "sure": 10.68
  },
  {
   "metin": "Belh'ten Serahs'a. Kârnâme-i Belḫ'te âlim ve şairleri eleştirmesi Belh halkının bir bölümünü ona karşı çevirdi. 505'te Belh'ten ayrılıp Serahs'a gitmek zorunda kaldı.",
   "bas": 82.08,
   "sure": 14.52
  },
  {
   "metin": "Seyrü’l-ʿibâd ile’l-meʿâd. Horasan Kadısı Muhammed b. Mansûr es-Serahsî'ye ithaf ettiği 700'den fazla beyitlik mesnevisinde sûfî seyrini alegorik biçimde anlattı.",
   "bas": 96.6,
   "sure": 12.36
  },
  {
   "metin": "Gazne'ye Dönüş. Behram Şah'ın elindeki Gazne'ye döndü. Hâce Âmid Ahmed b. Mes'ûd-i Tişâʾî ona ev yaptırdı, geçimini üstlendi ve eserlerinin toplanmasını sağladı.",
   "bas": 108.96,
   "sure": 13.944
  },
  {
   "metin": "Külliyatın Son Hâli. Divan ve mesnevilerini hayatının sonuna kadar düzenleyen Senâî, külliyatına son şeklini veremeden vefat etti. Dostları ve talebeleri eksikleri tamamladı.",
   "bas": 122.904,
   "sure": 14.4
  },
  {
   "metin": "Gazne'de Vefat. Gazne'de vefat etti. Türbesi Gazne'dedir. Ölüm tarihi için 525 (1131) tarihi daha doğru görülür.",
   "bas": 137.304,
   "sure": 13.32
  }
 ],
