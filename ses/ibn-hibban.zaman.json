 "toplamSure": 135.288,
 "bloklar": [
  {
   "metin": "Büst'te Doğum. Sicistan bölgesindeki Büst'te doğdu. Arap kabilelerinden Temîm'e mensup olduğu için Temîmî nisbesiyle de anılır.",
   "bas": 0,
   "sure": 10.968
  },
  {
   "metin": "Büst ve Çevresinde Tahsil. İlk öğrenimini Büst ve çevresinde yaptı. Daha sonra hadis, fıkıh, Arap dili, kelâm, felsefe, tıp ve nücûm alanlarında geniş bir tahsil programı izledi.",
   "bas": 10.968,
   "sure": 14.904
  },
  {
   "metin": "Geniş İlim Seyahati. İsbîcâb'dan başlayarak Horasan, Mâverâünnehir, Irak, Hicaz, Şam, Mısır ve İskenderiye'ye kadar uzanan bir seyahat gerçekleştirdi; âlî isnadlı rivayet imkânı buldu.",
   "bas": 25.872,
   "sure": 14.664
  },
  {
   "metin": "Basra'da Hadis Hocaları. Ebû Halîfe Fazl b. Hubâb el-Cumahî ve Zekeriyyâ es-Sâcî'den hadis aldı. Mısır'da Nesâî, Musul'da Ebû Ya'la el-Mevsılî ile çalıştı.",
   "bas": 40.536,
   "sure": 13.464
  },
  {
   "metin": "Nîşâbur'da Ders ve Metot. Nîşâbur'da Muhammed b. İshak es-Serrâc'tan hadis aldı. İbn Huzeyme'den hadis ve fıkıh dersleri aldı; onun metodunu benimsedi.",
   "bas": 54,
   "sure": 13.2
  },
  {
   "metin": "Semerkant'ta Suffe. Sâmânî Emîri Ebü'l-Muzaffer, Semerkant'ta hadis talebeleri için onun adına bir suffe yaptırdı. İbn Hibbân 330 yılına kadar burada hadis ve fıkıh okutti.",
   "bas": 67.2,
   "sure": 14.808
  },
  {
   "metin": "Nîşâbur'da İmlâ Meclisleri. Nîşâbur'da iki kez imlâ meclisi kurdu; hadis dersleri verdi ve kendi adına yaptırılan hankahta bazı eserlerini yazdırdı.",
   "bas": 82.008,
   "sure": 11.64
  },
  {
   "metin": "Zindıklık İthamı ve Ayrılış. Sîstan'da Müşebbihe çevrelerinin kelâm ve felsefeyle meşgul olduğu ileri sürülerek zındıklıkla itham edildi. Sübkî, sürülme anlatısının başka bir kişiye ait olabileceğini belirtir.",
   "bas": 93.648,
   "sure": 15.984
  },
  {
   "metin": "Dârü'l-İlim Vakfı. Büst'teki evini, kitaplarını ve vakıf gelirlerini hadis medresesi ve misafirhane olarak vakfetti; kitapların korunması ve dışarı çıkarılmaması için vasî tayin etti.",
   "bas": 109.632,
   "sure": 13.68
  },
  {
   "metin": "Büst'te Vefat. Büst'te vefat etti ve evinin yakınındaki hadis medresesinde defnedildi. Eserleri dârü'l-ilim vakfı sayesinde korunmaya çalışıldı.",
   "bas": 123.312,
   "sure": 11.976
  }
 ],
