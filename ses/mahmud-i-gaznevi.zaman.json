 "toplamSure": 183.552,
 "bloklar": [
  {
   "metin": "Buhara'da Doğum. Buhara'da doğdu. Babası Gazneli hükümdarı Sebük Tegin, annesi Zâbülistanlı asil bir ailedenydi. Dinî tahsili ve devlet yönetimi için yetiştirildi.",
   "bas": 0,
   "sure": 14.808
  },
  {
   "metin": "Gazne'de Vekil. Sebük Tegin, Sîstan'ı kontrol için Büst'e çekildiğinde Mahmud'u Gazne'de vekil bıraktı. Genç yaşta idari ve askerî tecrübe kazandı.",
   "bas": 14.808,
   "sure": 12.864
  },
  {
   "metin": "Gazne Kalesi'nde Hapis. Dedikodular yüzünden babasıyla arası açıldı ve Gazne Kalesi'ne hapsedildi. Birkaç ay sonra anlaşma sağlanınca serbest bırakıldı.",
   "bas": 27.672,
   "sure": 13.128
  },
  {
   "metin": "Sâmânîler'e Yardım. Sâmânî Emîri II. Nûh'un yardımıyla Ebû Ali es-Simcûrî ve Fâik'e karşı savaşa katıldı. II. Nûh ona “Seyfüddevle” lakabını verdi ve Horasan ordusu kumutanı yaptı.",
   "bas": 40.8,
   "sure": 16.992
  },
  {
   "metin": "Taht Mücadelesi ve Gazne Hâkimiyeti. Babası ölünce vasiyete göre İsmâil tahta çıktı. Mahmud kardeşinin hükümdarlığını tanımadı; iki kardeşin orduları karşılaştı ve Mahmud zaferle Gazneli tahtına oturdu.",
   "bas": 57.792,
   "sure": 16.608
  },
  {
   "metin": "Horasan'ın Fethi. Sâmânî kuvvetlerini yendi ve Horasan'ı ele geçirdi. Kardeşi Nasr'ı vali yaptı; zaferi Bağdat'a bildirerek Abbâsî halifesinin onayını aldı.",
   "bas": 74.4,
   "sure": 13.368
  },
  {
   "metin": "Halifeden Unvanlar. Abbâsî Halifesi Kādir-Billâh, Mahmud'un saltanatını tasdik etti ve ona “Yemînü'd-devle ve emînü'l-mille” unvanlarını verdi.",
   "bas": 87.768,
   "sure": 11.52
  },
  {
   "metin": "Hint Seferlerinin Başlangıcı. İlk seferinde Lamgan kalelerini, ikinci seferinde Vayhand'ı, üçüncü seferinde Bâtîyâ'yı fethetti. Bölgelere camiler yaptırdı ve din âlimleri gönderdi.",
   "bas": 99.288,
   "sure": 14.928
  },
  {
   "metin": "Mültan, Pencap ve Nagarkot. Mültan'da Karmatîlere karşı sefer düzenledi. Anandpâl'ın ordusuyla savaştı ve Nagarkot Kalesi'ni üç günlük kuşatmayla fethetti.",
   "bas": 114.216,
   "sure": 14.064
  },
  {
   "metin": "Keşmir, Kannevc ve Mathûrâ. Keşmir'e yeniden hâkim oldu, Thânesâr'daki tapınakları tahrip etti ve Kannevc ile Mathûrâ'yı fethetti. Bölgeye âlimler gönderdi.",
   "bas": 128.28,
   "sure": 13.92
  },
  {
   "metin": "Sûmenât Fethi. Sûmenât Kalesi'ni fethetti. Tapınaktaki büyük put dört parçaya ayrıldı; iki parça Gazne'ye, ikisi Mekke ve Medine'ye gönderildi.",
   "bas": 142.2,
   "sure": 12.432
  },
  {
   "metin": "Hârizm'in Fethi. Hârizmşah Me'mûn'un anlaşmasına rağmen ordu isyan etti. Mahmud, Hârizm kuvvetlerini yenerek Gürgenç'e girdi ve Me'mûnîler hânedanına son verdi.",
   "bas": 154.632,
   "sure": 13.824
  },
  {
   "metin": "Gazne'de Vefat. Gazne'de vefat etti. Öldüğünde Gazneli Devleti batıda Azerbaycan'dan doğuda Yukarı Ganj'a, kuzeyde Hârizm'den güneyde Hint Okyanusu'na kadar uzanan geniş topraklara sahipti.",
   "bas": 168.456,
   "sure": 15.096
  }
 ],
