 "bloklar": [
  {
   "metin": "Kuhendiz'de Doğum. 2 Şâban 396'da (4 Mayıs 1006) Herat'ın eski kalesi Kuhendiz'de doğdu. Soyu sahâbeden Ebû Eyyûb el-Ensârî'nin oğlu Mett'e ulaşır.",
   "bas": 0,
   "sure": 14.016
  },
  {
   "metin": "Mâlînî Medresesi'nde İlk Tahsil. İlk öğrenimine Mâlînî Medresesi'nde başladı. Dokuz yaşına girdiğinde Kadı Ebû Mansûr el-Ezdî ve Ebü'l-Fazl el-Cârûdî gibi âlimlerin derslerini takip ederek hadis yazmaya başladı.",
   "bas": 14.016,
   "sure": 16.68
  },
  {
   "metin": "Vaaz ve Ezber İlmi. On dört yaşında vaaz verecek kadar bilgi sahibiydi. Gece gündüz ders çalıştığını anlatır; 70.000 beyit Arapça şiir ezberlediği yolundaki rivayetler güçlü hâfızasına işaret eder.",
   "bas": 30.696,
   "sure": 15.504
  },
  {
   "metin": "Nîşâbur'da Tahsil. Fıkıh ve hadis dersleri almak, şeyhlerle görüşmek için Nîşâbur'a gitti; Ebû Nasr Mansûr Ahmed, Ebû Saîd es-Sayrafî gibi âlimlerin derslerine devam etti. Eş'arî oldukları gerekçesiyle bazı ünlülerle görüşmedi.",
   "bas": 46.2,
   "sure": 18.216
  },
  {
   "metin": "Yahyâ b. Ammâr'ın Vasiyeti. Yahyâ b. Ammâr eş-Şeybânî'den hadis ve tefsir dinledi. Hocası ölüm döşeğinde onun vaaz vermesini vasiyet etti; Herevî yerine geçti ve \"onu görmemiş olsaydım vaaz etme cesaretini bulamazdım\" dedi.",
   "bas": 64.416,
   "sure": 18.12
  },
  {
   "metin": "Bağdat ve Ebû Muhammed el-Hallâl. Hac için yola çıktı; Nîşâbur'dan sonra Bağdat'a gitti ve Ebû Muhammed el-Hallâl ile görüştü. Yol güvenliği bulunmadığından Bistâm, Nîşâbur ve Tûs'a uğrayarak Horasanlı hacılarla döndü.",
   "bas": 82.536,
   "sure": 17.592
  },
  {
   "metin": "Harakānî ile Karşılaşma. Tekrar hac yolculuğuna çıktı; Nîşâbur'da Ebû Saîd-i Ebü'l-Hayr'ı ziyaret etti, el-Âmülî'yi gördü. En önemli hadise olarak \"tasavvuf yolunda mürşidim\" dediği Ebü'l-Hasan el-Harakānî ile karşılaşmasını anlatır.",
   "bas": 100.128,
   "sure": 18.192
  },
  {
   "metin": "Nübâzân'da Kırk Gün. İsmâil Çiştî ile Nübâzân'a gitti. Kaldığı kırk gün içinde Harakānî'den öğrendiği tasavvuf anlayışını açıklayarak âlimleri derinden etkiledi; semâ meclislerinde semâ yaptı.",
   "bas": 118.32,
   "sure": 15.528
  },
  {
   "metin": "Gazneli Sultan Mesud'a Şikâyet. Aynı yıl babası Ebû Mansûr Belh'te vefat etti. Herevî, Mu'tezile ve Eş'arî âlimleri tarafından Mücessime'den olmakla suçlanarak Sultan Mesud'a şikâyet edildi; hükümdarı tutumunun doğruluğuna ikna etti.",
   "bas": 133.848,
   "sure": 17.784
  },
  {
   "metin": "Bûşenc'de Hapis. Kur'an tefsiri sırasında bid'atçı saydığı mezhepleri, özellikle Mu'tezile ve Eş'arîleri eleştirdi; müteşâbih âyetleri te'vil edenlere şiddetle çattı. Ulemânın şikâyeti üzerine tutuklanıp Bûşenc'de hapsedildi, ertesi yıl çıkıp tefsiri yeniden başlattı.",
   "bas": 151.632,
   "sure": 20.16
  },
  {
   "metin": "Belh'e Sürgün. Şâfiîler ve Hanefîler onu Nizâmülmülk'e şikâyet etti; kamu düzeninin bozulacağı uyarısı üzerine Herat'tan Belh'e sürüldü. Aynı yılın sonunda sürgün hayatı bitince Herat'a döndü.",
   "bas": 171.792,
   "sure": 15.048
  },
  {
   "metin": "Kāim-Biemrillâh'ın Hediyeleri. Halife Kāim-Biemrillâh, Nizâmülmülk'ün aracılığıyla kıymetli hediyeler göndererek Herevî'yi ödüllendirdi. Şöhreti arttı; refah içinde vaaz, tefsir dersleri ve eser yazımı sürdü.",
   "bas": 186.84,
   "sure": 15.96
  },
  {
   "metin": "Menâzilü's-sâ'irîn ve Unvan. Talebelerinin isteğiyle Ṣad Meydân'ı genişleterek 475'te (1082) Menâzilü's-sâ'irîn'i, ardından Ẕemmü'l-kelâm'ı yazdı. 476'da (1083) Halife Kāim-Biemrillâh \"şeyhülislâm\" ve \"şeyhüşşüyûh\" unvanlarını tevcih etti.",
   "bas": 202.8,
   "sure": 21.336
  },
  {
   "metin": "Esmâ-i Hüsnâ Şerhi ve Sürgün. Ṭabaḳātü'ṣ-ṣûfiyye'de düzeltmelerini tamamladı ve esmâ-i hüsnâyı şerhetmeye başladı. Bir kelâm âlimiyle tartışmasının ardından müridlerinin âlimi dövüp evini yakmasından sorumlu tutuldu; Herat'tan çıkarılıp Bûşenc'den de sürüldü.",
   "bas": 224.136,
   "sure": 19.2
  },
  {
   "metin": "Yarım Kalan Tefsir. Merverrûz'da İmam Ferrâ el-Begavî tarafından karşılandı. 480'de (1087) Herat'a dönmesine izin verilince yarım bıraktığı tefsirini hızla tamamlamaya çalıştı; ancak Sâd sûresinin 67. âyetine kadar gelebildi.",
   "bas": 243.336,
   "sure": 18.888
  },
  {
   "metin": "Gazürgâh'ta Vefat. 22 Zilhicce 481'de (8 Mart 1089) vefat etti; Herat'a 5 km uzaklıktaki Gazürgâh'a defnedildi. Türbesi Selçuklular döneminde inşa edildi, yanına medrese yapıldı; bugünkü yapıyı 829'da (1426) Şâhruh yaptırdı.",
   "bas": 262.224,
   "sure": 22.392
  }
 ],
