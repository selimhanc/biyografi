 "bloklar": [
  {
   "metin": "Yemâme'de Doğum. Peygamber Efendimiz'den (s.a.v.) iki sene sonra Hicaz'ın Yemâme bölgesinde doğdu. Babası Ebû Kuhâfe, annesi Selmâ bint-i Sahr'dır. Soyu hem ana hem baba tarafından Peygamber Efendimiz'in (s.a.v.) dedelerinden Mürre'de birleşmektedir.",
   "bas": 0,
   "sure": 20.304
  },
  {
   "metin": "Câhiliyye Çağında \"Abdü Rabbi'l-Ka'be\". Câhiliyye yıllarında bu isimle anılıyor, kabilesi içinde saygın bir yerde bulunuyordu. Peygamber Efendimiz'in (s.a.v.) daveti üzerine Müslüman olunca kendisine \"Abdullâh\" ismi verildi.",
   "bas": 20.304,
   "sure": 17.52
  },
  {
   "metin": "Hiç Delil Aramadan Îmân. Peygamber Efendimiz (s.a.v.) insanları İslâm'a davet ederken hiç tereddüt etmeden Müslüman oldu. Erkeklerden ilk iman eden oldu; Mi'râc mûcizesini tereddütsüz tasdik ettiği için \"Sıddîk\" lâkâbı verildi.",
   "bas": 37.824,
   "sure": 18.432
  },
  {
   "metin": "İnsanları Îmâna Daveti. Müslüman olduktan sonra insanları îmâna davet etti. Talha, Osmân, Zübeyr b. Avvâm gibi birçok kişi onun davetiyle Müslüman oldu; İslâm'a davette Peygamber Efendimiz'den (s.a.v.) sonra ikinci sırayı aldı.",
   "bas": 56.256,
   "sure": 19.128
  },
  {
   "metin": "Malının Tamamını Vermesi. Peygamber Efendimiz (s.a.v.) \"Ebû Bekir'in malının bana verdiği faydayı başka hiç kimsenin malı vermemiştir\" buyurunca ağladı ve \"Canım, malım sana fedâ olsun Yâ Resûlallâh!\" dedi. Îmân ettiği zaman kırk bin dirhemi vardı; hicret ettikleri zaman yalnız beş bin dirhemi kalmıştı.",
   "bas": 75.384,
   "sure": 22.08
  },
  {
   "metin": "Yedi Köleyi Satın Alıp Azâd Etmesi. Müslüman oldukları için işkence gören yedi kişiyi satın alıp kölelikten azâd etti. Bilâl-i Habeşî ve Âmir b. Füheyre bunlardan ikisidir.",
   "bas": 97.464,
   "sure": 14.472
  },
  {
   "metin": "Sevr Mağarasında Zikr-i Hâfî Telkîni. Peygamber Efendimiz (s.a.v.) \"Üzülme\" buyurup \"Çünkü Allâhü Teâlâ muhakkak bizimle beraberdir\" dedi. Hz. Ebû Bekir (r.a.) bu maiyyetin sırrını sorunca \"Bunun sırrı, Allâhü Teâlâ'yı zikre devam etmektir\" buyurularak zikr-i hâfî-i kalbîyi telkin etti.",
   "bas": 111.936,
   "sure": 22.152
  },
  {
   "metin": "Ciğerinden Yükselen Muhabbet. Zikr-i kalbîde cemiyeti temin ile zât-ı aliyyeyi müşahede etmek arzusunda nefesini tutar; Allâh'a olan muhabbetin ateşiyle adeta ciğerinin yanmasından bir koku çıkardı. Komşuları bunun kebap kokusu sanıp rahatsız olunca Peygamber Efendimiz (s.a.v.) bunun ciğerinden gelen koku olduğunu bildirdi.",
   "bas": 134.088,
   "sure": 23.184
  },
  {
   "metin": "İlk Olduğu Hususlar. Erkekler içinde ilk Müslüman olması; Kur'ân âyetlerini ilk defa bir araya toplatıp \"Mushaf\" demesi; ilk defa \"Sıddîk, Atîk ve Halîfe\" diye isimlendirilmesi; Beytülmâli ilk defa tesis etmesi; malının tamamını ilk defa Resûlüllâh (s.a.v.) için harcaması; ilk hac emîri tayin olunması.",
   "bas": 157.272,
   "sure": 23.544
  },
  {
   "metin": "Halifeliğe Getirilmesi. Resûlüllâh (s.a.v.) hastalandığında imamlık makamına onu vazifelendirmişti. İrtihâlinin ardından halifeliğe geçirildi; halifeliği iki yıl, üç ay, on gün sürdü.",
   "bas": 180.816,
   "sure": 15.408
  },
  {
   "metin": "Resûlüllâh'ın (s.a.v.) İrtihâli. Resûlüllâh'ın (s.a.v.) irtihâli onun da vefat sebebi oldu. Peygamber Efendimiz'in (s.a.v.) vefatı üzerine çok üzüldü; her geçen gün vücudu eriyip gitti.",
   "bas": 196.224,
   "sure": 15.6
  },
  {
   "metin": "Hücre-i Saâdet'te Vefat. 23 Cemâziyelâhir 13 (M. 634) salı gecesi âhirete irtihâl etti. Hz. Ömer (r.a.) Mescid-i Nebevî'de cenaze namazını kıldırdı. Kabri oğlu Abdurrahmân, Ömer, Osmân ve Talha tarafından indirildi; başı Peygamber Efendimiz'in (s.a.v.) omuzları hizasına gelecek şekilde defnedildi.",
   "bas": 211.824,
   "sure": 25.512
  }
 ],
