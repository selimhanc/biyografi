 "bloklar": [
  {
   "metin": "Medîne'de Doğum. 8 Ramazân-ı Şerîf 80 (M. 699) tarihinde Medîne-i Münevvere'de dünyaya geldi. Ehl-i Beyt'in büyüklerindendir; künyesi Ebû Abdullah ve Ebû İsmâîl'dir.",
   "bas": 0,
   "sure": 15.384
  },
  {
   "metin": "Sahâbelerle Görüşmesi. Tâbiîn'den olup sahâbeden Enes b. Mâlik ve Sehl b. Sa'd (r.anhümâ) ile görmüştür. Babası Muhammed Bâkır, onun babası Ali Zeynelâbidîn, onun babası Hz. Hüseyin ve onun babası da Emîru'l-mü'minîn Hz. Ali'dir (r.anhüm).",
   "bas": 15.384,
   "sure": 19.368
  },
  {
   "metin": "\"Sâdık\" Lâkâbı. Sözlerindeki sadakatinden dolayı \"Sâdık\" lâkâbıyla meşhur oldu. Ehl-i Beyt'in büyüklerinden olmasının yanında silsilenin dördüncü halkası olarak kabul edildi.",
   "bas": 34.752,
   "sure": 14.28
  },
  {
   "metin": "Talebe Yetiştirmesi. Medîne'de düzenlediği ilmî meclislerde birçok talebe yetiştirdi. Sözlerinde sadakatinden dolayı \"Sâdık\" lâkâbıyla anılan bu zat, Ehl-i Beyt'in büyüklerindendi.",
   "bas": 49.032,
   "sure": 14.808
  },
  {
   "metin": "İmâm-ı Âzam'ın İntisâbı. İmâm-ı Âzam Nu'mân b. Sâbit Hazretleri Câfer-i Sâdık (r.a.)'a intisâb etti ve \"Ca'fer-i Sâdık'a intisâb ettiğim şu iki sene olmasaydı Nu'mân helâk olurdu\" buyurdu.",
   "bas": 63.84,
   "sure": 14.64
  },
  {
   "metin": "Medîne'de Vefat. Şevval ayında 148 (M. 765) senesinde 68 yaşında iken Medîne-i Münevvere'de âhirete irtihâl etti ve babasının da medfun bulunduğu Bâkî' Kabristanına defnolundu.",
   "bas": 78.48,
   "sure": 15.192
  }
 ],
