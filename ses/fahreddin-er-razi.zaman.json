 "toplamSure": 154.104,
 "bloklar": [
  {
   "metin": "Rey'de Doğum. Büyük Selçuklu başşehri Rey'de doğdu. 544 doğum tarihi da zikredilir. Soyu Arap asıllı bir aileye dayandırılan Bekrî, Teymî ve Kureşî nisbeleriyle anılır.",
   "bas": 0,
   "sure": 15.288
  },
  {
   "metin": "Simnân'da Eğitim. Babası Ömer er-Râzî öldüğünde on altı yaşındaydı. Simnân'a giderek Kemâleddin es-Simnânî'nin derslerine devam etti.",
   "bas": 15.288,
   "sure": 11.664
  },
  {
   "metin": "Merâga'da Mecdüddin el-Cîlî. Önce Rey'e döndü, ardından Mecdüddin el-Cîlî'den kelâm ve felsefe tahsil etti. Cîlî ile birlikte Merâga'ya giderek öğrenimini sürdürdü.",
   "bas": 26.952,
   "sure": 13.464
  },
  {
   "metin": "İlim ve Felsefe Seyahati. Cürcân, Tûs, Herat, Hârizm, Buhara, Semerkant, Hucend, Belh, Gazne ve Hindistan beldelerine seyahat etti. İlmi seyahatler ününün oluşmasında büyük payı oldu.",
   "bas": 40.416,
   "sure": 15.96
  },
  {
   "metin": "Hârizm Münazaraları. Hârizm'de Mu'tezilî âlimlerle yaptığı münazara sonrası bazı olaylar çıktı; şehri terk edip Rey'e dönmek zorunda kaldı.",
   "bas": 56.376,
   "sure": 11.016
  },
  {
   "metin": "Serahs ve İbn Sînâ Şerhi. Serahs'ta tabip Abdurrahman b. Abdülkerim ile tanıştı ve dostluk kurdu. İbn Sînâ'nın el-Kānûn'unu bu tabip için şerhetti.",
   "bas": 67.392,
   "sure": 12.408
  },
  {
   "metin": "Buhara'da Fıkıh ve İtikad Tartışmaları. Hanefî âlimlerle fıkıh, Mâtürîdiyye çevresiyle itikadî meseleler üzerine münazara yaptı; Bâtınîler ve Kerrâmîlerle de tartışmaları büyük yankı uyandırdı.",
   "bas": 79.8,
   "sure": 14.112
  },
  {
   "metin": "Herat'a Yerleşme. İran, Türkistan, Afganistan ve Hindistan'ı dolaştıktan sonra 600 (1203) yılında Herat'a yerleşti. Eserlerini yazdı ve 300'ü aşkın talebe yetiştirdi.",
   "bas": 93.912,
   "sure": 15.048
  },
  {
   "metin": "Bâtınî Karşıtı Münazara. Bâtınî bir dinleyicinin gizlice takip edip ölümle tehdit etmesi üzerine eleştirilerini kesen Râzî, öğrencilerine “Bâtınîler'in burhân-ı kātı‘ları vardır” cevabını verdi.",
   "bas": 108.96,
   "sure": 14.208
  },
  {
   "metin": "Kur'an Metoduna Dönüş. Ömrünün sonuna doğru kelâmî ve felsefî yöntemlerin insanı kesin tatmine ulaştıramayacağını düşündü; herkesi Kur'an'ın metoduna davet etti. Vasiyetini talebesi İbrâhim el-İsfahânî'ye yazdırdı.",
   "bas": 123.168,
   "sure": 16.2
  },
  {
   "metin": "Herat'ta Vefat. Herat'ta vefat etti. Kerrâmîlerce zehirletildiği anlatılsa da bu kesin değildir. Naaşı, vasiyetine uygun olarak Muzdâhân yakınlarında defnedildi.",
   "bas": 139.368,
   "sure": 14.736
  }
 ],
