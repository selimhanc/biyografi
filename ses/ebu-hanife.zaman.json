 "bloklar": [
  {
   "metin": "Kûfe'de Doğum. Kûfe'de doğdu. Nesebi Nu‘mân b. Sâbit b. Zûtâ b. Mâh olarak verilir; ailesinin Fars kökenli olduğu yönündeki rivayet, diğer etnik köken iddialarına göre daha güçlü görülür.",
   "bas": 0,
   "sure": 15.144
  },
  {
   "metin": "Kur'an ve Kıraat. Küçük yaşta Kur'an'ı ezberlediği ve kıraat ilmini Âsım b. Behdele'den öğrendiği kaynaklarda anlatılır. Aynı dönemde kumaş ticaretiyle meşgul olduğu ve maddî ihtiyaçlarını karşıladığı rivayet edilir.",
   "bas": 15.144,
   "sure": 16.104
  },
  {
   "metin": "İlime Yöneliş. Ebû Amr eş-Şa‘bî onu zeki ve hareketli bir genç olarak görüp ilim meclislerini ihmal etmemesi gerektiğini söyledi. Bu rivayet, ticaretle ilim arasındaki geçişin başlangıç noktası olarak sunulur.",
   "bas": 31.248,
   "sure": 16.2
  },
  {
   "metin": "Hammâd'ın Ders Halkası. Hammâd b. Ebû Süleyman ın derslerine katıldı ve yaklaşık on sekiz yıl boyunca Kûfe re'y ekolünün bu önemli ustasından fıkıh ve usûl öğrendi.",
   "bas": 47.448,
   "sure": 12.312
  },
  {
   "metin": "Kendi Ders Halkasını Kurma. Hammâd'ın ölümünün ardından arkadaşlarının ve talebelerinin ısrarıyla onun yerine geçti. Dönemin İslâm ülkelerinden gelen öğrencilerle geniş bir ders halkası oluşturdu.",
   "bas": 59.76,
   "sure": 15.192
  },
  {
   "metin": "Zeyd b. Ali'nin İsyanı. Zeyd b. Ali nin Hişâm'a karşı başlattığı isyana maddî ve fıkıhî destek verdiği nakledilir. Bu ilişki tarihî bir gerçek gibi değil, kaynaklardaki destek anlatısının özeti olarak gösterilir.",
   "bas": 74.952,
   "sure": 16.656
  },
  {
   "metin": "Zeyd b. Ali'nin Öldürülmesi. Zeyd b. Ali'nin öldürülmesi, Emevî hilâfetine karşı Ehl-i beyt bağlamındaki muhalefetin ve Ebû Hanîfe'nin siyasî tutumunun değerlendirilmesinde dönüm noktasıdır.",
   "bas": 91.608,
   "sure": 13.872
  },
  {
   "metin": "Yahyâ b. Ali'nin İsyanı. Zeyd b. Ali'nin oğlu Yahyâ'nın Horasan'daki isyanı ve öldürülmesi, Emevî döneminin siyasî baskı ortamını gösteren olaylardandır.",
   "bas": 105.48,
   "sure": 12.048
  },
  {
   "metin": "Görev Teklifi ve Hapis. II. Mervân döneminde Kûfe kadılığı veya beytülmâl eminliği teklif edildi. Baskıya rağmen görevi kabul etmedi; hapsedildi ve dövüldü. Sağlığı bozulunca serbest bırakılıp Mekke'ye gitti.",
   "bas": 117.528,
   "sure": 17.328
  },
  {
   "metin": "Abbâsîlere Biat ve Kûfe'ye Dönüş. Emevî hilâfetinin sona ermesiyle Kûfe'ye dönerek Ebü'l-Abbas es-Seffâh'a biat etti. Irak'taki karışıklık sürdüğü için yeniden Mekke'ye döndü; siyasî durum yatışınca tekrar Kûfe'ye yerleşti.",
   "bas": 134.856,
   "sure": 17.112
  },
  {
   "metin": "Abdullah b. Hasan'ın Hapiste Ölümü. Abdullah b. Hasan b. Hasan'ın hapiste ölmesi, Ehl-i beyt bağlamındaki gerilimin artmasında önemli bir olaydır.",
   "bas": 151.968,
   "sure": 11.52
  },
  {
   "metin": "İsyanlar ve Başkaldırıya Yöneliş. Abdullah b. Hasan'ın oğullarından Muhammed'in Medine'de ve İbrâhim'ın Irak'ta isyan etmesi, sonraki dönemde Ebû Hanîfe'nin Abbâsî iktidarına karşı daha açık bir tavır almasıyla ilişkilendirilir.",
   "bas": 163.488,
   "sure": 16.248
  },
  {
   "metin": "Musul Anlaşması ve Hukukî İtiraz. Mansûr'un Musul halkıyla yaptığı anlaşmada cezalandırma yetkisinin şartlara bağlanması, hukuk dışı bir sözleşme örneği olarak tartışıldı. Ebû Hanîfe'nin itirazı, Allah'ın koyduğu şartların bağlayıcılığına dayanıyordu.",
   "bas": 179.736,
   "sure": 18.84
  },
  {
   "metin": "Bağdat Kadılığı Teklifi. Mansûr, yeni kurulan Bağdat'ın kadılığını teklif etti. Daha sağlam rivayetlerde görevi kabul etmedi; bunun üzerine hapsedildi, işkence gördü ve dövüldü. Bazı kaynaklar kısa süre görev yaptığını ileri sürer.",
   "bas": 198.576,
   "sure": 19.224
  },
  {
   "metin": "Bağdat'ta Vefat. Bağdat'ta vefat etti ve vasiyeti üzerine Hayzürân Kabristanı'na defnedildi. 459 (1067)'de Şerefülmülk Ebû Sa'd el-Müstevfî tarafından mezarının üzerine türbe ve medrese yaptırıldı; yer bugün Âzamiye olarak anılır.",
   "bas": 217.8,
   "sure": 18.576
  }
 ],
