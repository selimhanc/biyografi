 "bloklar": [
  {
   "metin": "Bistâm'da Doğum. 188 (M. 803) senesinde İran'ın kuzeyinde, Hazar Denizi yakınında Bistâm şehrinde dünyaya geldi. İsmi Tayfûr, künyesi Ebû Yezîd, lâkabı Sultânü'l-Ârifîn, babasının ismi Îsâ'dır.",
   "bas": 0,
   "sure": 17.832
  },
  {
   "metin": "Üç Kardeş Zâhid Hayat. Âdem ve Ali isminde iki kardeşi olup üçü de âbid ve zâhid idiler. Zühd ve ibadet hayatıyla tanınmış, Allah'a yaklaşmayı hedef eden bir yaşam sürmüştür.",
   "bas": 17.832,
   "sure": 14.52
  },
  {
   "metin": "Câfer-i Sâdık'ın Rûhâniyyetiyle Terbiyesi. Bâyezîd-i Bestâmî (K.S) Üveysî'dir. Onu, İmâm Câferu's-Sâdık (r.a.) Hazretlerinin rûhâniyyeti terbiye etmiştir; bu terbiye ile Üveysî silsilesine bağlandı.",
   "bas": 32.352,
   "sure": 17.208
  },
  {
   "metin": "\"Sultânü'l-Ârifîn\" Lâkâbı. İrfan sahibi âlimler arasında en üstün makamı ifade eden \"Sultânü'l-Ârifîn\" lâkâbıyla anıldı. Silsile-i Sâdât'ın beşinci halkası olarak kabul edildi.",
   "bas": 49.56,
   "sure": 15.816
  },
  {
   "metin": "Hakka Vâsıl Olma Sırrı. Bir kişi gelip \"Kurtuluşuma sebep olacak bir şey öğret\" dedi; \"Şu iki şeyi iyi öğren. Bunları öğrenirsen başka bir şeye ihtiyacın olmaz: Allahü Teâlâ seni bilir, seni ve yaptıklarını her zaman görür\" buyurdu.",
   "bas": 65.376,
   "sure": 17.952
  },
  {
   "metin": "Hürmeti terk Edenler. \"Hakka vâsıl olanlar, hürmete riâyet ederek vâsıl olmuşlardır. Kovulanlar da hürmeti terk ettikleri için kovulmuşlardır.\" Sözüyle, hürmetin kemâle ulaşmanın ön şartı olduğunu vurguladı.",
   "bas": 83.328,
   "sure": 17.28
  },
  {
   "metin": "Vefatı. 261 (M. 874) veya 264 (M. 877) senesinde âhirete irtihâl etti. Vefat tarihi kaynaklarda farklı olarak zikredilmiştir.",
   "bas": 100.608,
   "sure": 15.144
  },
  {
   "metin": "Kabr-i Şerîflerinin Yeri. Kabr-i şerîflerinin muhtelif yerlerde olduğu söylenmekle beraber en meşhuru Bistâm'dadır. Hatay'ın Kırıkhan ilçesi yakınında makamının bulunduğu da rivayet olunmaktadır.",
   "bas": 115.752,
   "sure": 14.328
  }
 ],
