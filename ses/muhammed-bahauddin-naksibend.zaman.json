{
 "ses": "tr-TR-AhmetNeural",
 "pitch": "+0st",
 "rate": "+0%",
 "bicer": "MP3 24kHz mono 48kbps",
 "toplamSure": 187.416,
 "bloklar": [
  {
   "metin": "Kasr-ı Hinduvan'da Doğum. 718 (M. 1318) senesinde Buhârâ yakınlarında, daha sonra Kasr-ı Arifân adını alacak olan Kasr-ı Hinduvan köyünde dünyaya geldi. İsmi Muhammed bin Muhammed bin Muhammed Bahâüddîn olup neseb-i şerîfleri İmâm Câfer-i Sâdık vasıtasıyla Hz. Ali'ye ulaşır.",
   "bas": 0,
   "sure": 21.744
  },
  {
   "metin": "Mânevî Evlatlık. Daha küçük bir çocukken Hâce Muhammed Baba Semâsî (k.s.) onu mânevî evlatlığa kabul etmiştir. Bu kabul, tarîkat yolundaki ilk manevî bağdır.",
   "bas": 21.744,
   "sure": 13.8
  },
  {
   "metin": "Zâhirî İlimleri Tahsili. Hanefî mezhebindendir. Hâcegân (kuddise sirruhum) silsilesinde, Hâme Mahmûd İncîrfağnevî'den Seyyid Emîr Kilâl'a kadar zikr-i hâfî ile zikr-i alâniyye cem' edilmiş, her ikisi de yapılmıştır. Bu yolun zâhirî edeplerini Hâce Seyyid Emîr Kilâl'den (k.s.) aldı.",
   "bas": 35.544,
   "sure": 22.104
  },
  {
   "metin": "Hâme Abdülhâlik-ı Gucdüvânî'nin Rûhâniyyeti. Şâh-ı Nakşibend hakîkatte ve bâtında \"Üveysî\"dir; onu Hâce Abdülhâlik-ı Gucdüvânî (k.s.) Hazretlerinin rûhâniyyeti terbiye etmiştir.",
   "bas": 57.648,
   "sure": 13.68
  },
  {
   "metin": "Zikr-i Alâniyyeyi Terk Edip Zikr-i Hâfîye Geçmesi. Hâce Abdülhâlik'ın (k.s.) rûhâniyetine intisâb edip onun ruhsat ve emirleriyle zikr-i alâniyyeyi tamamen terk etti ve zikr-i hâfî ile meşgul oldu. Zikr-i hâfî mürîdlerinin kalbinde büyük bir tesir bırakmıştır.",
   "bas": 71.328,
   "sure": 18.984
  },
  {
   "metin": "\"Nakşibend\" Adının Verilmesi. Bu tesir nakşa, zikre tesbite yarayan bağa benzetilmiştir. Mürîdlerin kalbine hiç çıkmayacak şekilde yerleştiği için kendisine \"Nakşibend\" denilmiştir. Mürîdlerine Nakşibendî denir, cemîi Nakşibendân'dır; tarikata Tarîkat-ı Nakşibendiyye denilmiştir.",
   "bas": 90.312,
   "sure": 22.2
  },
  {
   "metin": "Emîr Kilâl'ın Tevccühü. Emîr Kilâl (k.s.) bütün mürîdlerinin huzûrunda ona teveccüh edip \"Evlâdım Bahâüddîn! Hâce Muhammed Baba Semâsî Hazretlerinin sizin hakkınızdaki emirlerini yerine getirdim. Seni nasıl terbiye ettim ise, sen de oğlum Bahâüddîn'i öyle terbiye et. Bu hususta asla kusur etme\" buyurdu.",
   "bas": 112.512,
   "sure": 24.744
  },
  {
   "metin": "Sağlam Halka ve Ender Yol. \"Bizim yolumuz ender bulunan yollardandır. Sağlam halkadır. Resûlüllâh Efendimizin (s.a.v.) sünnet-i seniyyesine sarılmaktan, Ashâb-ı Kirâm'ın takip ettiği yolu takip etmekten başka bir şey değildir.\"",
   "bas": 137.256,
   "sure": 18.264
  },
  {
   "metin": "Son Nefesler ve Vefat. Hâce Alâüddin Attâr (k.s.) buyurdu: \"Hâce Hazretlerinin irtihâlinden hemen önce yanında Yâsîn-ı Şerîf okumaya başladım. Yarısına geldiğimde nûr zâhir olmaya başladı. Kelime-i tevhidle meşgul olduktan sonra son nefeslerini verdiler.\" 3 Rebîulevvel 791 (M. 1389) pazartesi günü âhirete irtihâl etti ve doğduğu Kasr-ı Hinduvan'a (bugünkü Bahâüddin köyü) defnedildi.",
   "bas": 155.52,
   "sure": 31.896
  }
 ],
